# Las consultas públicas funcionan sin configurar estas variables.
# Copia este archivo a .env para consultar una cuenta existente.

# Clave privada del firmante (0x seguido de 64 caracteres hexadecimales).
POLYMARKET_PRIVATE_KEY=

# Dirección de la cuenta de Polymarket que controla el firmante.
# Es obligatoria para el modo autenticado de este proyecto.
POLYMARKET_WALLET_ADDRESS=

# Credenciales CLOB L2 opcionales: configura las tres o deja las tres vacías.
# Si están vacías, el SDK las deriva usando la clave privada.
# No son claves de Builder ni de Relayer.
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=

# Rutas de esta máquina (opcional). Por defecto se usan data/, models/ y reports/ del repo.
# Las rutas relativas se interpretan desde la raíz del repositorio.
POLYM4V_DATA_DIR=
POLYM4V_MODELS_DIR=
POLYM4V_REPORTS_DIR=

# Nivel de log: DEBUG, INFO, WARNING o ERROR (por defecto INFO).
POLYM4V_LOG_LEVEL=
